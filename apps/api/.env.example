DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/treasury_sentinel
MILVUS_URI=http://localhost:19530
# If your Milvus enables username/password auth, fill these two fields.
MILVUS_USER=
MILVUS_PASSWORD=
# Optional. Fill this only if your Milvus deployment uses a non-default database.
MILVUS_DB_NAME=
# Optional alternative auth style. Leave empty when using user/password.
MILVUS_TOKEN=
MILVUS_COLLECTION=treasury_policy_chunks_bge_zh_v1
EMBEDDING_MODEL_PATH=/Volumes/wd2t/model/bge-small-zh-v1.5

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-mini-260428
DOUBAO_PRIMARY_TEMPERATURE=0.1
DOUBAO_CRITIC_TEMPERATURE=0.1
DOUBAO_TIMEOUT_SECONDS=60
DOUBAO_PRIMARY_MAX_TOKENS=192
DOUBAO_CRITIC_MAX_TOKENS=160
DOUBAO_DECISION_MODE=risk_based

KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_WALLET_ADDRESS=
# 执行状态轮询 worker:启用开关与轮询间隔(秒)
KEEPERHUB_POLL_ENABLED=true
KEEPERHUB_POLL_INTERVAL_SECONDS=30

BASE_SEPOLIA_RPC_URL=
CHAIN_ID=84532
