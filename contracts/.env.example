# Required for deployment and live contract interaction.
# Use a Base Sepolia RPC URL from Alchemy, QuickNode, Infura, Ankr, or another provider.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Required for `npx hardhat run scripts/deploy.js --network baseSepolia`.
# Use a testnet-only deployer private key with Base Sepolia ETH for gas.
# Never use a mainnet wallet or a wallet holding real funds.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Optional. Used only if you later add contract verification.
# BaseScan uses the Etherscan-compatible API key flow for Base Sepolia.
ETHERSCAN_API_KEY=

# Optional for `npm run deploy:mock-usdc:base-sepolia`.
# Defaults to the deployer address and 1000 demo USDC when empty.
MINT_TO=
MINT_AMOUNT_USDC=1000

# Required for `npm run fund:guard:base-sepolia`.
# MOCK_USDC_ADDRESS is printed by deploy-mock-usdc.js.
# TREASURY_GUARD_ADDRESS is printed by deploy.js.
MOCK_USDC_ADDRESS=
TREASURY_GUARD_ADDRESS=

# Optional notes for the live demo after deployment.
# TREASURY_GUARD_ADDRESS belongs in apps/api/.env after deployment.
# KeeperHub wallet must receive EXECUTOR_ROLE before live Agent execution.
